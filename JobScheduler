.timer-container {
  display: flex;
  justify-content: center;
  margin-top: 50px;
}

.timer-box {
  background: #f3f4f6;
  padding: 25px 40px;
  border-radius: 12px;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 15px;
}

.unit {
  display: flex;
  flex-direction: column;
  align-items: center;
}

#min, #sec {
  font-size: 40px;
  font-weight: bold;
}

.label {
  font-size: 12px;
  color: #666;
  margin-top: 5px;
}

.colon {
  font-size: 40px;
  font-weight: bold;
}
