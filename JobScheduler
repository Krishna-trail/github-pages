/* Reset */
* {
  box-sizing: border-box;
}

/* Body */
.qrcodeexpiredbody {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f5f5;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 100vh;
  padding: 16px;
}

/* Remove center tag effect */
.logobody {
  width: 100%;
}

/* Header section */
.logoheader {
  width: 100%;
}

.topBanner {
  width: 100%;
  border-bottom: 1px solid #e5e7eb;
  padding: 10px 0;
}

.topBannerLogo {
  display: flex;
  justify-content: flex-start;
  padding-left: 16px;
}

#logo-c {
  width: clamp(30px, 8vw, 45px);
  height: auto;
}

/* Card */
.card {
  width: 100%;
  max-width: 420px;
  background: #ffffff;
  border-radius: 12px;
  padding: 24px;
  margin: 0 auto;
}

/* Icon */
.icon {
  width: clamp(60px, 18vw, 80px);
  height: clamp(60px, 18vw, 80px);
  background: #1e5aa5;
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;
  font-size: clamp(24px, 6vw, 36px);
  margin-bottom: 20px;
}

/* Title */
.title {
  font-size: clamp(18px, 2.8vw, 22px);
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12px;
}

/* Text */
.header {
  font-size: clamp(13px, 2.5vw, 14px);
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 10px;
}

/* Buttons */
.container-imgs {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.appstore-logo,
.googleplay-logo {
  width: clamp(140px, 50%, 180px);
  height: auto;
}

/* Footer */
.copyrightfooter {
  margin-top: 20px;
  text-align: center;
}

.footer-ror {
  width: 100%;
}

.copyright {
  font-size: clamp(11px, 2vw, 12px);
  color: #6b7280;
}
