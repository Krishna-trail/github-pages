/* Page Centering */
.qrcodeexpiredbody {
    margin: 0;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background: #2b2b2b;
}

/* Card */
.card {
    background: #ffffff;
    padding: 30px 20px;
    border-radius: 10px;
    width: 320px;
    text-align: left;
}

/* Header */
.header {
    font-size: 13px;
    color: #1f2937;
    margin-bottom: 10px;
    text-align: left;
}

/* Icon */
.icon {
    width: 50px;
    height: 50px;
    background-color: #2f80ed;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 20px;
}

/* Title */
.title {
    font-size: 16px;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 10px;
}

/* Subtitle */
.subtitle {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 20px;
    line-height: 1.5;
}

/* Button */
.btn {
    background-color: #336cf2;
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 20px;
    font-size: 14px;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    background-color: #2303bd;
}

/* Footer */
.footer {
    margin-top: 20px;
    font-size: 12px;
    color: #9ca3af;
    text-align: center;
}

/* Logo/Header area */
.logoheader {
    width: 100%;
    height: 60px;
    background-color: white;
}

/* Top Banner */
.topBanner,
.topBanner-line,
.topNav-center,
.topNav-line,
.footer-row {
    width: 100%;
    max-width: 990px;
    margin: 0 auto;
}

/* Remove fixed margins (important fix) */
.topBanner-line {
    height: 60px;
}

/* Navigation */
.topNav {
    width: 100%;
    background-color: #33303d45;
}

/* Empty space */
.topNav-bar-empty {
    width: 100%;
    height: 38px;
}

/* Copyright */
.copyright {
    width: 100%;
    font-size: 10px;
    font-weight: bold;
    color: #455560;
    text-align: center;
    margin-top: 10px;
}

/* Footer wrapper */
.copyrightfooter {
    width: 100%;
    margin-top: 30px;
}

/* Logo body */
.logobody {
    min-height: 60px;
    background-color: #ffffff;
    font-size: 12px;
    border-bottom: 1px solid lightgrey;
}

/* Logo container */
.topBannerLogo {
    width: 100%;
    height: 60px;
}

/* Logo */
#logo-c {
    height: 30px;
    margin-top: 15px;
}

/* Store images */
.appstore-logo,
.googleplay-logo {
    height: auto;
    max-width: 150px;
    margin-top: 10px;
}

/* Image container */
.container-imgs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
@media (max-width: 768px) {
    .card {
        width: 90%;
        padding: 20px;
    }

    .btn {
        width: 100%;
    }
}
