/* Base reset */
* {
  box-sizing: border-box;
}

/* Page body */
.qrcodeexpiredbody {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #ffffff;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 100vh;
  padding: 16px;
}

/* Main card */
.card {
  background: #ffffff;
  width: 100%;
  max-width: 420px; /* important for desktop */
  padding: 24px;
  border-radius: 12px;
  text-align: left;
}

/* Header icon */
.header img {
  width: 40px;
  height: auto;
}

/* Info icon circle */
.info-icon {
  width: 80px;
  height: 80px;
  background: #1e5aa5;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 24px 0;
}

.info-icon span {
  color: white;
  font-size: 36px;
  font-weight: bold;
}

/* Heading */
.title {
  font-size: 20px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12px;
}

/* Description text */
.desc {
  font-size: 14px;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 16px;
}

/* Store buttons container */
.store-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

/* Store images */
.store-buttons img {
  width: 160px;
  max-width: 100%;
}

/* Footer */
.footer {
  font-size: 12px;
  color: #6b7280;
  margin-top: 24px;
  text-align: center;
}
@media (max-width: 480px) {
  .card {
    padding: 16px;
  }

  .title {
    font-size: 18px;
  }

  .desc {
    font-size: 13px;
  }

  .info-icon {
    width: 70px;
    height: 70px;
  }

  .store-buttons img {
    width: 140px;
  }
}
