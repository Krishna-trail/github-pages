/* Reset */
* {
  box-sizing: border-box;
}

/* Body */
.qrcodeexpiredbody {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #ffffff;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 100vh;
  padding: 16px;
}

/* Card */
.card {
  width: 100%;
  max-width: 420px;   /* controls desktop width */
  padding: 5%;        /* responsive padding */
  background: #fff;
  border-radius: 12px;
}

/* Header */
.header img {
  width: 10%;         /* scales automatically */
  min-width: 32px;    /* prevents too small */
  max-width: 48px;
}

/* Info icon */
.info-icon {
  width: 20vw;
  height: 20vw;
  max-width: 80px;
  max-height: 80px;

  background: #1e5aa5;
  border-radius: 50%;

  display: flex;
  justify-content: center;
  align-items: center;

  margin: 20px 0;
}

.info-icon span {
  font-size: 5vw;
  max-font-size: 36px;
  color: #fff;
}

/* Title */
.title {
  font-size: clamp(16px, 2.5vw, 20px);
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12px;
}

/* Description */
.desc {
  font-size: clamp(13px, 2.2vw, 14px);
  color: #6b7280;
  line-height: 1.5;
}

/* Buttons */
.store-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.store-buttons img {
  width: 60%;
  max-width: 180px;
}

/* Footer */
.footer {
  font-size: clamp(11px, 2vw, 12px);
  text-align: center;
  margin-top: 20px;
  color: #6b7280;
}
